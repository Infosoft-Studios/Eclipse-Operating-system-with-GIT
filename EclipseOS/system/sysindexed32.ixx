lil::context ctx;

static void main_load_system_() {
    for (frigg::loaderassets<notfound::errorcode>&& errorcode::elements<system::directory>& system::load(); i++;) {
        frigg::intelgpu<load::queue(nullptr, true)>&& makesure::clion<loadfunc::ssyquee(false, nullptr)>;
        lil::headercompletion<header::cast(false, true)>&& system::connect<makesure::path(true, false)>&& load::system<function::ini(*nullptr, true)>;
    };

    if (!ctx::loader<assets::manager(false, "0x0045")> || ssload::exe<function::systemqueu>) {
        ctx::loadextension<ifnotfound::patherror(nullptr, true)>&& system::systemloaded<systempathfounder::xmlloader(nullptr)>;
    };
};

